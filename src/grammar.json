{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "tree_sitter_ballerina",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "_module_decl"
      }
    },
    "_module_decl": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "type_decl"
        }
      ]
    },
    "type_decl": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "STRING",
              "value": "public"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": "type"
        },
        {
          "type": "SYMBOL",
          "name": "identifier"
        },
        {
          "type": "SYMBOL",
          "name": "type_descriptor"
        },
        {
          "type": "STRING",
          "value": ";"
        }
      ]
    },
    "type_descriptor": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_basic_type"
        },
        {
          "type": "SYMBOL",
          "name": "_union_type"
        },
        {
          "type": "SYMBOL",
          "name": "_intersection_type"
        },
        {
          "type": "SYMBOL",
          "name": "_optional_type"
        },
        {
          "type": "SYMBOL",
          "name": "_distinct_type"
        }
      ]
    },
    "_basic_type": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "int"
        },
        {
          "type": "STRING",
          "value": "float"
        },
        {
          "type": "STRING",
          "value": "string"
        },
        {
          "type": "STRING",
          "value": "boolean"
        },
        {
          "type": "SYMBOL",
          "name": "_nil_literal"
        }
      ]
    },
    "_nil_literal": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "null"
        },
        {
          "type": "STRING",
          "value": "()"
        }
      ]
    },
    "_union_type": {
      "type": "PREC_LEFT",
      "value": 0,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
            "name": "type_descriptor"
          },
          {
            "type": "STRING",
            "value": "|"
          },
          {
            "type": "SYMBOL",
            "name": "type_descriptor"
          }
        ]
      }
    },
    "_intersection_type": {
      "type": "PREC_LEFT",
      "value": 0,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
            "name": "type_descriptor"
          },
          {
            "type": "STRING",
            "value": "&"
          },
          {
            "type": "SYMBOL",
            "name": "type_descriptor"
          }
        ]
      }
    },
    "_optional_type": {
      "type": "PREC_LEFT",
      "value": 0,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
            "name": "type_descriptor"
          },
          {
            "type": "STRING",
            "value": "?"
          }
        ]
      }
    },
    "_distinct_type": {
      "type": "PREC_LEFT",
      "value": 0,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "distinct"
          },
          {
            "type": "SYMBOL",
            "name": "type_descriptor"
          }
        ]
      }
    },
    "word": {
      "type": "SYMBOL",
      "name": "identifier"
    },
    "identifier": {
      "type": "PATTERN",
      "value": "[a-zA-Z_]\\w*"
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}